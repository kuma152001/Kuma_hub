    if input.KeyCode == Enum.KeyCode.Insert or input.KeyCode == Enum.KeyCode.RightShift then
        if State.Gui then
            local main = State.Gui:FindFirstChild("Main")
            if main then main.Visible = not main.Visible end
        end
    end
end)


local function GetReplicaData()
    local data = nil
    pcall(function()
        local ReplicaListener = Knit.GetController("ReplicaListener")
        if ReplicaListener then
            local replica = ReplicaListener:GetReplica()
            if replica then data = replica.Data end
        end
    end)
